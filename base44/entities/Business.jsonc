{
  "name": "Business",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated owner user ID"
    },
    "name": {
      "type": "string",
      "description": "Tree service company name"
    },
    "phone": {
      "type": "string",
      "description": "Business callback phone number"
    },
    "email": {
      "type": "string",
      "description": "Notification and reply email address"
    },
    "logo_uri": {
      "type": "string",
      "description": "Private file URI for business logo"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "min_charge": {
      "type": "number",
      "default": 0
    },
    "terms": {
      "type": "string",
      "description": "Default proposal terms and conditions"
    },
    "price_book": {
      "type": "object",
      "description": "Optional rate matrix by work type, tree size, hazards, haul percentage, and rounding"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "active"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "trial"
    },
    "trial_started_at": {
      "type": "string",
      "description": "ISO timestamp set on the business's first sent quote"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}