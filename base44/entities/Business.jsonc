{
  "name": "Business",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated owner user ID"
    },
    "name": {
      "type": "string",
      "description": "Painting and decorating company name"
    },
    "phone": {
      "type": "string",
      "description": "Business callback phone number"
    },
    "email": {
      "type": "string",
      "description": "Notification and reply email address"
    },
    "logo_uri": {
      "type": "string",
      "description": "Private file URI for business logo"
    },
    "currency": {
      "type": "string",
      "default": "NZD"
    },
    "gst_number": {
      "type": "string",
      "description": "Optional NZ IRD / GST registration number"
    },
    "gst_rate": {
      "type": "number",
      "default": 0.15
    },
    "prices_include_gst": {
      "type": "boolean",
      "default": false
    },
    "default_stud_m": {
      "type": "number",
      "default": 2.4
    },
    "openings_pct": {
      "type": "number",
      "default": 10
    },
    "min_charge": {
      "type": "number",
      "default": 0
    },
    "terms": {
      "type": "string",
      "description": "Default proposal terms and conditions"
    },
    "price_book": {
      "type": "object",
      "description": "Optional NZ painter rate card by surface m2/m, doors, windows, prep, coats, and rounding"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "founding",
        "active"
      ],
      "enumColors": [
        "yellow",
        "purple",
        "green"
      ],
      "default": "trial"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "monthly"
    },
    "trial_started_at": {
      "type": "string",
      "description": "ISO timestamp set on the business's first sent quote"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}