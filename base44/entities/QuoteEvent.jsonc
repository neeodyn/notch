{
  "name": "QuoteEvent",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "created",
        "captured",
        "edited",
        "undone",
        "sent",
        "viewed",
        "accepted",
        "declined",
        "followed_up"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "yellow",
        "gray",
        "blue",
        "green",
        "red",
        "green"
      ]
    },
    "meta": {
      "type": "object"
    }
  },
  "required": [
    "quote_id",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}