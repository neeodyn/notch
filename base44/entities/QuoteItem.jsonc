{
  "name": "QuoteItem",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string"
    },
    "area_number": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "interior",
        "exterior",
        "extra"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple"
      ],
      "default": "interior"
    },
    "length_m": {
      "type": "number"
    },
    "width_m": {
      "type": "number"
    },
    "stud_m": {
      "type": "number"
    },
    "area_m2_spoken": {
      "type": "number"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "walls",
          "ceiling",
          "skirting",
          "weatherboards",
          "soffits",
          "fascia"
        ]
      }
    },
    "doors": {
      "type": "number",
      "default": 0
    },
    "windows": {
      "type": "number",
      "default": 0
    },
    "coats": {
      "type": "number",
      "default": 2
    },
    "prep": {
      "type": "string",
      "enum": [
        "light",
        "standard",
        "heavy"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow"
      ],
      "default": "standard"
    },
    "prep_notes": {
      "type": "string"
    },
    "colour": {
      "type": "string"
    },
    "spoken_price": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "price_book_estimate": {
      "type": "number"
    },
    "price_source": {
      "type": "string",
      "enum": [
        "spoken",
        "price_book",
        "owner",
        "none"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple",
        "yellow"
      ],
      "default": "none"
    },
    "optional": {
      "type": "boolean",
      "default": false
    },
    "is_optional_split": {
      "type": "boolean",
      "default": false
    },
    "needs_owner_price": {
      "type": "boolean",
      "default": false
    },
    "flagged": {
      "type": "boolean",
      "default": false
    },
    "customer_description": {
      "type": "string"
    },
    "start_segment": {
      "type": "number"
    }
  },
  "required": [
    "quote_id",
    "area_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}